+/// What the node says the limits are: the four modality ceilings plus the
+/// effort range, as one record.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ChainCeilings {
+    pub text_bytes: u64,
+    pub image_pixels: u64,
+    pub audio_ms: u64,
+    pub video_frames: u64,
+    pub effort_min_tenths: u64,
+    pub effort_max_tenths: u64,
+}
+
+/// Parse a `bud_aiGetCeilings` response.
+///
+/// WIRING: the read-only node query the registered set carries but the agent
+/// must not send - it is deliberately outside `ALLOWED_METHODS`, so there is
+/// no request builder here; the operator's tooling supplies the response and
+/// this parser is the shape contract the node endpoint must satisfy.
+///
+/// A missing or zero ceiling is a refusal, not a default: reading "no value"
+/// as "no limit" is the one mistake a ceiling reader must never make, and an
+/// inverted effort range is an answer that cannot be honored by both ends.
+///
+/// # Errors
+/// Malformed JSON-RPC, an error object, a missing field, a zero ceiling, or
+/// a range where the maximum is below the minimum.
+pub fn parse_get_ceilings(response: &str) -> Result<ChainCeilings, String> {
+    let value: Value =
+        serde_json::from_str(response).map_err(|e| format!("not valid JSON-RPC: {e}"))?;
+    if let Some(error) = value.get("error") {
+        return Err(format!("RPC error: {error:?}"));
+    }
+    let result = value.get("result").ok_or("response has no result object")?;
+    let ceiling = |name: &str| -> Result<u64, String> {
+        let got = uint_field(result, name)?;
+        if got == 0 {
+            return Err(format!("`{name}` is zero; refusing to read no-ceiling as no-limit"));
+        }
+        Ok(got)
+    };
+    let ceilings = ChainCeilings {
+        text_bytes: ceiling("text_bytes")?,
+        image_pixels: ceiling("image_pixels")?,
+        audio_ms: ceiling("audio_ms")?,
+        video_frames: ceiling("video_frames")?,
+        effort_min_tenths: uint_field(result, "effort_min_tenths")?,
+        effort_max_tenths: uint_field(result, "effort_max_tenths")?,
+    };
+    if ceilings.effort_max_tenths < ceilings.effort_min_tenths {
+        return Err(format!(
+            "effort range is inverted: {} below {}",
+            ceilings.effort_max_tenths, ceilings.effort_min_tenths
+        ));
+    }
+    Ok(ceilings)
+}
+
 /// The only chain methods Lubot may call. The set is registered in
 /// `training/rpc-seti.json`; the gate keeps the file and this constant in
 /// agreement, so an extension is a reviewable change in both places - and
@@ -238,6 +295,41 @@ pub fn consumes(agreeing: usize, threshold: u64) -> bool {
 mod tests {
     use super::*;
 
+    #[test]
+    fn ceilings_parse_their_shape_and_refuse_defaults() {
+        let good = r#"{
+            "jsonrpc": "2.0",
+            "id": 1,
+            "result": {
+                "text_bytes": 8192,
+                "image_pixels": 1048576,
+                "audio_ms": 60000,
+                "video_frames": 120,
+                "effort_min_tenths": 5,
+                "effort_max_tenths": 100
+            }
+        }"#;
+        let ceilings = parse_get_ceilings(good).expect("a complete answer parses");
+        assert_eq!(ceilings.text_bytes, 8192);
+        assert_eq!(ceilings.effort_max_tenths, 100);
+
+        let zeroed = good.replace("8192", "0");
+        assert!(parse_get_ceilings(&zeroed)
+            .unwrap_err()
+            .contains("no-ceiling as no-limit"));
+
+        let missing = good.replace("\"audio_ms\": 60000,", "");
+        assert!(parse_get_ceilings(&missing)
+            .unwrap_err()
+            .contains("missing field"));
+
+        let inverted = good.replace("\"effort_max_tenths\": 100", "\"effort_max_tenths\": 1");
+        assert!(parse_get_ceilings(&inverted).unwrap_err().contains("inverted"));
+
+        let errored = r#"{"jsonrpc":"2.0","id":1,"error":{"code":-32000,"message":"no"}}"#;
+        assert!(parse_get_ceilings(errored).unwrap_err().starts_with("RPC error"));
+    }
+
     #[test]
     fn request_bodies_name_the_method_and_params() {
         let body = jsonrpc_request("bud_aiGetOutcome", vec![Value::String("0x01".into())])
