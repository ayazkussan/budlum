+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn digest_of(kind: &str) -> [u8; 32] {
+        GOLDEN_PINS
+            .iter()
+            .find(|p| p.label == kind)
+            .map(|p| p.digest)
+            .expect("pinned case exists")
+    }
+
+    #[test]
+    fn table_has_four_unique_digests() {
+        assert_eq!(GOLDEN_PINS.len(), 4);
+        for (i, a) in GOLDEN_PINS.iter().enumerate() {
+            for b in GOLDEN_PINS.iter().skip(i + 1) {
+                assert_ne!(a.digest, b.digest);
+            }
+        }
+    }
+
+    #[test]
+    fn known_digest_resolves_to_its_pin() {
+        let d = digest_of("all_ones_ff");
+        let (label, anchor, verdict) = pinned_anchor(&d).expect("pinned");
+        assert_eq!(label, "all_ones_ff");
+        assert_eq!(verdict, Verdict::Affirm);
+        assert!(evidence_matches(&d, &anchor));
+        assert!(anchor.iter().any(|b| *b != 0));
+    }
+
+    #[test]
+    fn unknown_digest_fails_closed() {
+        let mut d = digest_of("all_zero");
+        d[5] ^= 0x55;
+        assert!(pinned_anchor(&d).is_none());
+        assert!(!evidence_matches(&d, &GOLDEN_PINS[0].anchor));
+    }
+
+    #[test]
+    fn wrong_anchor_is_rejected_bitwise() {
+        let d = digest_of("genesis");
+        let (_, anchor, _) = pinned_anchor(&d).expect("pinned");
+        let mut wrong = anchor;
+        wrong[31] ^= 1;
+        assert!(!evidence_matches(&d, &wrong));
+    }
+
+    #[test]
+    fn ring_pin_is_frozen() {
+        assert!(ring_bump_matches(&RING_BUMP_ANCHOR));
+        let mut wrong = RING_BUMP_ANCHOR;
+        wrong[0] ^= 1;
+        assert!(!ring_bump_matches(&wrong));
+        assert_eq!(RING_BUMP_TICKS, 64);
+    }
+
+    #[test]
+    fn manifest_root_is_a_real_sha256_hex() {
+        assert_eq!(BUDFLY_MANIFEST_ROOT_SHA256.len(), 64);
+        assert!(BUDFLY_MANIFEST_ROOT_SHA256
+            .bytes()
+            .all(|c| c.is_ascii_hexdigit() && !c.is_ascii_uppercase()));
+    }
+}
