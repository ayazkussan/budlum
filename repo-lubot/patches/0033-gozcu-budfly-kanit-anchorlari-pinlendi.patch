+
+/// Look up the pinned anchor for an evidence digest. Fails closed: an
+/// unknown digest is `None`, never an approximation.
+pub fn pinned_anchor(digest: &[u8; 32]) -> Option<(&'static str, [u8; 32], Verdict)> {
+    GOLDEN_PINS
+        .iter()
+        .find(|p| &p.digest == digest)
+        .map(|p| (p.label, p.anchor, p.verdict))
+}
+
+/// Byte-check a claimed BudFly anchor against the pins. `false` on any bit
+/// difference, `false` for unpinned digests.
+pub fn evidence_matches(digest: &[u8; 32], claimed_anchor: &[u8; 32]) -> bool {
+    matches!(pinned_anchor(digest), Some((_, a, _)) if &a == claimed_anchor)
+}
+
+/// Claimed ring-bump anchor check (bump scenario has no digest input).
+pub fn ring_bump_matches(claimed_anchor: &[u8; 32]) -> bool {
+    claimed_anchor == &RING_BUMP_ANCHOR
+}
