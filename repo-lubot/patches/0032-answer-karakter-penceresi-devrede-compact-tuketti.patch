 crates/answer/src/lib.rs    | 54 ++++++++++++++++++++++++++++++++++++-
 gates/dead-pub-api.baseline |  1 -
 2 files changed, 53 insertions(+), 2 deletions(-)

diff --git a/crates/answer/src/lib.rs b/crates/answer/src/lib.rs
index b6445cc..b5ce15c 100644
--- a/crates/answer/src/lib.rs
+++ b/crates/answer/src/lib.rs
@@ -15,10 +15,20 @@
 //!    from the grant book, so "revoked" is never reported as "not found".
 
 use lubot_grant::{Decision, GrantBook, Seconds, Visibility};
-use lubot_index::{Index, Passage};
+use lubot_index::{compact, Index, Passage};
 use lubot_read::Corpus;
 use lubot_tools::{route, scope, Route};
 
+/// The character window one grounded answer embeds. The passage COUNT is
+/// the reader's knob (five by default, effort-tiered on the CLI); this is
+/// the SIZE knob: indexing bounds a passage in lines, never in WIDTH, so
+/// one pathological line could otherwise ship megabytes inside a small,
+/// well-behaved five-passage answer. The window is enforced by
+/// `lubot_index::compact`, which keeps the ranked prefix that fits and
+/// drops the rest in deterministic order - same corpus, same question,
+/// same document, on every reader.
+pub const ANSWER_CHAR_BUDGET: usize = 16_384;
+
 /// What the reader gets back.
 #[derive(Debug, Clone, PartialEq, Eq)]
 pub enum Answer {
@@ -163,6 +173,12 @@ impl<'a, C: Corpus> Reader<'a, C> {
         let passages = self
             .index
             .search(question, &allowed, self.passages_per_answer);
+        // Size gate before grounding: what does not fit the window is not
+        // cited. If NOTHING fits - a first passage wider than the whole
+        // budget - the honest verdict is the no-evidence answer below: the
+        // ranking must not smuggle an oversized passage past the window
+        // just because it scored first.
+        let (passages, _dropped) = compact(passages, ANSWER_CHAR_BUDGET);
         if !passages.is_empty() {
             return Answer::Grounded { passages };
         }
@@ -235,6 +251,42 @@ mod tests {
         }
     }
 
+    #[test]
+    fn evidence_that_fits_walks_through_the_window_untouched() {
+        let c = corpus();
+        let reader = Reader::new(&c, 2, 3);
+        let mut grants = GrantBook::new();
+        match reader.ask("someone", "what does revocation do?", &mut grants, 1) {
+            Answer::Grounded { passages } => {
+                assert_eq!(passages[0].item_id, "public-doc");
+                assert!(
+                    passages.iter().map(|p| p.text.len()).sum::<usize>() < ANSWER_CHAR_BUDGET,
+                    "fixture evidence is small: compaction must be a no-op, not a crop"
+                );
+            }
+            other => panic!("the window must not touch evidence that fits: {other:?}"),
+        }
+    }
+
+    #[test]
+    fn a_huge_passage_is_compacted_out_not_squeezed_in() {
+        let mut c = FixtureCorpus::new();
+        // One line of tiny tokens: the SEARCH hits ("x" is everywhere), the
+        // passage is over the window, and it is the only evidence - so the
+        // answer is NotFound precisely because the window refused a
+        // megabyte-sized citation, not because retrieval found nothing.
+        let body = vec!["x"; ANSWER_CHAR_BUDGET / 2 + 1].join(" ");
+        c.insert(Item::new("giant", "docs/giant.md", SourceKind::Local, false, &body))
+            .unwrap();
+        let reader = Reader::new(&c, 2, 3);
+        let mut grants = GrantBook::new();
+        assert_eq!(
+            reader.ask("someone", "x", &mut grants, 1),
+            Answer::NotFound,
+            "oversized first-ranked evidence grounds nothing - the window is law"
+        );
+    }
+
     #[test]
     fn private_content_is_invisible_without_a_grant() {
         let c = corpus();
