From 7b4a5568d0b3e06b7d0d9ff9aade2c7c19c16c3d Mon Sep 17 00:00:00 2001
From: ayazkussan <149924814+ayazkussan@users.noreply.github.com>
Date: Thu, 10 Sep 2026 06:36:55 +0000
Subject: [PATCH 6/6] lubot kapi: gate runner izolasyonu (fail-isolate)

check.py --all: tek gate env-hatasi (orn. cargo yoklugu FileNotFoundError) tum kosuyu abort ediyordu; selftest dahil gate govdesi izole edildi, hata FAIL sayilip kosu surer, ozet satiri korunur. cargo'suz kosuda kanitlandi (22 OK / 16 FAIL-hepsi-cevresel, abort yok).
---
 gates/check.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/gates/check.py b/gates/check.py
index 46cba7a..a00923e 100644
--- a/gates/check.py
+++ b/gates/check.py
@@ -1697,12 +1697,15 @@ def main(argv: list[str]) -> int:
     if argv[0] == "--all":
         failures = 0
         for name, (run, selftest) in GATES.items():
-            selftest()
             try:
+                selftest()
                 print(f"OK   [{name}] {run()}")
             except SystemExit as err:
                 failures += 1
                 print(f"FAIL [{name}] {err}")
+            except Exception as err:
+                failures += 1
+                print(f"FAIL [{name}] {type(err).__name__}: {err}")
         print("ALL GATES PASSED" if not failures else f"{failures} gate(s) failed")
         return 1 if failures else 0
     name = argv[0]
