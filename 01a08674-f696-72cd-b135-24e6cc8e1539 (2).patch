++        // High with an attester: accepted.
++        review
++            .reject(
++                "high",
++                Waiver {
++                    reason: "no attacker can reach it".to_owned(),
++                    attester: "s-01".to_owned(),
++                },
++            )
++            .unwrap();
++        assert_eq!(
++            review.reject(
++                "crit",
++                Waiver {
++                    reason: "theoretical".to_owned(),
