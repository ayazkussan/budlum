+        let (tx, _rx) = tokio::sync::mpsc::channel(1);
+        let mut w = RelayerWorker::new(ChainHandle::new(tx), Address::from([7u8; 32]));
+        w.observed.insert(
+            "req".to_string(),
+            PendingResult {
+                result: Some(observation(3)),
+                submitted_tx: None,
+                requester_lookups_failed: 0,
+            },
+        );
+        w.save_pending();
+        assert!(w.load_pending().expect("load").is_empty());
+    }
