+
+    fn observation(tag: u8) -> RelayerExternalResult {
+        RelayerExternalResult {
+            chain: ExternalChain::Ethereum,
+            tx_hash: format!("0x{tag:02x}"),
+            success: true,
+            message: None,
+            receipt_proof: vec![tag; 4],
+            external_state_root: [tag; 32],
+        }
+    }
